#!/usr/bin/env php
<?php
/**
 * Stand-in for `phpstan analyse --error-format=json` in the tests: reports one
 * error on every line of each file given after "--", with the message
 * "<basename>:<line>", so the tests can see exactly which lines were kept.
 */

$files     = array();
$afterDash = false;
foreach (array_slice($argv, 1) as $argument) {
	if ($argument === '--') {
		$afterDash = true;
		continue;
	}
	if (!$afterDash || !is_file($argument)) {
		continue;
	}
	$messages = array();
	foreach (file($argument) as $index => $line) {
		$messages[] = array(
			'message'   => basename($argument) . ':' . ($index + 1),
			'line'      => $index + 1,
			'ignorable' => true,
		);
	}
	$files[realpath($argument)] = array( 'errors' => count($messages), 'messages' => $messages );
}

echo json_encode(array(
	'totals' => array( 'errors' => 0, 'file_errors' => count($files) ),
	'files'  => $files ?: new stdClass(),
	'errors' => array(),
));
