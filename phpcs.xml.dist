<?xml version="1.0"?>
<ruleset name="phpstan-diff">
	<description>PSR-12 with tabs, short arrays, and some of the Slevomat sniffs that PHPStan uses.</description>

	<config name="php_version" value="80200"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="encoding" value="utf-8"/>
	<arg name="tab-width" value="4"/>
	<arg name="cache" value="vendor/.phpcs-cache"/>
	<arg value="sp"/>

	<!-- The scripts have no .php extension, so they're named individually. -->
	<file>bin/phpstan-diff</file>
	<file>bin/phpstan-diff-filter</file>
	<file>src</file>
	<file>tests/fake-phpstan</file>
	<file>tools/build-phar</file>

	<rule ref="PSR12">
		<!-- Tabs instead of PSR-12's spaces. -->
		<exclude name="Generic.WhiteSpace.DisallowTabIndent"/>
	</rule>
	<rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
	<rule ref="Generic.WhiteSpace.ScopeIndent">
		<properties>
			<property name="indent" value="4"/>
			<property name="tabIndent" value="true"/>
		</properties>
	</rule>

	<!-- Arrays: short syntax, no padding inside single-line brackets, and a trailing comma in multi-line ones. -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
	<rule ref="SlevomatCodingStandard.Arrays.SingleLineArrayWhitespace"/>
	<rule ref="SlevomatCodingStandard.Arrays.TrailingArrayComma"/>

	<!-- From the sniffs PHPStan enables (https://github.com/phpstan/build-cs). -->
	<rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
		<properties>
			<property name="linesCountBeforeDeclare" value="1"/>
			<property name="spacesCountAroundEqualsSign" value="0"/>
		</properties>
	</rule>
	<rule ref="SlevomatCodingStandard.Operators.DisallowEqualOperators"/>
	<rule ref="SlevomatCodingStandard.ControlStructures.EarlyExit">
		<exclude name="SlevomatCodingStandard.ControlStructures.EarlyExit.UselessElseIf"/>
	</rule>
	<rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator"/>
	<rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceEqualOperator"/>
	<rule ref="SlevomatCodingStandard.Functions.StaticClosure"/>
	<rule ref="SlevomatCodingStandard.Functions.UnusedInheritedVariablePassedToClosure"/>
	<rule ref="SlevomatCodingStandard.Operators.RequireCombinedAssignmentOperator"/>
	<rule ref="SlevomatCodingStandard.PHP.UselessParentheses"/>
	<rule ref="SlevomatCodingStandard.PHP.UselessSemicolon"/>
	<rule ref="SlevomatCodingStandard.TypeHints.NullTypeHintOnLastPosition"/>
	<rule ref="SlevomatCodingStandard.Variables.UnusedVariable"/>
	<rule ref="SlevomatCodingStandard.Variables.UselessVariable"/>
</ruleset>
