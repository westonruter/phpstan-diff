{
	"name": "westonruter/phpstan-diff",
	"description": "Run PHPStan and report only the errors on lines changed relative to a base branch.",
	"license": "MIT",
	"type": "library",
	"keywords": [
		"phpstan",
		"static analysis",
		"git",
		"diff",
		"code review"
	],
	"authors": [
		{
			"name": "Weston Ruter",
			"homepage": "https://weston.ruter.net/"
		}
	],
	"homepage": "https://github.com/westonruter/phpstan-diff",
	"support": {
		"issues": "https://github.com/westonruter/phpstan-diff/issues",
		"source": "https://github.com/westonruter/phpstan-diff"
	},
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"ergebnis/composer-normalize": "^2.57",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-strict-rules": "^2.0",
		"slevomat/coding-standard": "^8.22",
		"squizlabs/php_codesniffer": "^4.0"
	},
	"suggest": {
		"ext-pcntl": "So that, when phpstan-diff is sent SIGTERM, it stops the git and PHPStan processes it started."
	},
	"bin": [
		"bin/phpstan-diff",
		"bin/phpstan-diff-filter"
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.2.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"cs": "phpcs",
		"cs-fix": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=2G",
		"release": [
			"Composer\\Config::disableProcessTimeout",
			"tools/release"
		]
	},
	"scripts-descriptions": {
		"release": "Tags main as a new version and pushes the tag, starting the release workflow (e.g. composer release 1.2.3)."
	}
}
