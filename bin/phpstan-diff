#!/usr/bin/env bash
#
# phpstan-diff — run PHPStan and show only the errors on lines this branch
# changed relative to a base branch (default: trunk).
#
# Usage:
#   phpstan-diff [--base=<ref>] [--fetch] [--staged] [--whole-project] [--format=table|json]
#                [--include=<glob>]... [--exclude=<glob>]... [-- <paths...>]
#
# By default PHPStan only analyses the .php files that differ from the base, since
# only errors on changed lines are reported anyway. Changed files that PHPStan's own
# configuration excludes (excludePaths) are skipped, and a note lists them; if that
# leaves nothing to analyse, the run passes.
#
# Options:
#   --base=<ref>      Base ref to diff against (default: $PHPSTAN_DIFF_BASE or "trunk").
#                     When it names a local branch, its remote-tracking counterparts
#                     (its upstream, origin/<branch> and upstream/<branch>) are
#                     considered too, and whichever this branch merged most recently
#                     is used (if several diverged, only lines changed relative to all
#                     of them count), so a stale local base branch doesn't pull
#                     upstream changes into the diff. One that already contains HEAD
#                     is skipped (unless it's checked out). Pass
#                     --base=refs/heads/<branch> to use the local branch as-is.
#   --fetch           Fetch the base's remote-tracking branches first (see --base),
#                     without stopping to prompt for credentials.
#   --staged          Diff the staged snapshot (the git index) against the base
#                     instead of the working tree: errors on committed + staged
#                     changes, with unstaged edits ignored. Add --base=HEAD to
#                     narrow it to staged changes only (e.g. from a pre-commit hook).
#   --whole-project   When no paths are given, run PHPStan on the whole configured
#                     project instead of just the changed .php files. Slower; only
#                     needed for rules that collect data across files (e.g. dead-code
#                     detection), whose verdict on a changed file depends on the rest.
#                     Errors are still reported only for changed lines.
#   --changed         Deprecated no-op: analysing only changed files is now the default.
#   --include=<glob>  Keep only files matching this repo-relative path or glob; the
#                     match is intersected with the files actually changed. Repeatable
#                     (a file is kept if it matches ANY --include). A bare directory
#                     (e.g. --include=src) matches everything under it. Unlike the
#                     positional <paths>, this is a filter over the changed files, not
#                     a PHPStan analysis target, and it understands globs.
#   --exclude=<glob>  Drop files matching this repo-relative path or glob (e.g.
#                     --exclude=tests). Repeatable; applied after --include, and an
#                     exclude wins over an include. Unless --whole-project is given,
#                     excluded files aren't handed to PHPStan at all (so the run is
#                     faster too).
#   --format=table    Human-readable table (default).
#   --format=json     Emit the filtered PHPStan JSON document.
#   -- <paths...>     Restrict PHPStan (and the diff) to these paths (PHPStan analysis
#                     targets; combine with --include/--exclude to filter further).
#
# Environment:
#   PHPSTAN_DIFF_BASE          Default base ref.
#   PHPSTAN_DIFF_ANALYSE_CMD   Command that runs PHPStan analyse. If set, used verbatim
#                              (our extra args are appended). If unset, auto-detected:
#                                1. `composer phpstan --`  (if a "phpstan" Composer script exists)
#                                2. `<vendor-bin>/phpstan analyse --memory-limit=2G`
#                                3. `phpstan analyse --memory-limit=2G`  (global install)
#
# Exit status: 1 if any errors remain after filtering, 0 otherwise, 2 on internal errors.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
FILTER="$SCRIPT_DIR/phpstan-diff-filter"

base="${PHPSTAN_DIFF_BASE:-trunk}"
staged=0
fetch=0
whole_project=0
format="table"
paths=()
includes=()
excludes=()
seen_dashdash=0

while [ "$#" -gt 0 ]; do
	if [ "$seen_dashdash" -eq 1 ]; then
		paths+=("$1"); shift; continue
	fi
	case "$1" in
		--) seen_dashdash=1 ;;
		--base=*) base="${1#--base=}" ;;
		--base) shift; base="${1:?--base requires a value}" ;;
		--staged|--cached) staged=1 ;;
		--fetch) fetch=1 ;;
		--whole-project) whole_project=1 ;;
		--changed) ;; # Deprecated: now the default.
		--include=*) includes+=("${1#--include=}") ;;
		--include) shift; includes+=("${1:?--include requires a value}") ;;
		--exclude=*) excludes+=("${1#--exclude=}") ;;
		--exclude) shift; excludes+=("${1:?--exclude requires a value}") ;;
		--format=*) format="${1#--format=}" ;;
		--format) shift; format="${1:?--format requires a value}" ;;
		-h|--help) awk 'NR>1{ if (!/^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; exit 0 ;;
		--*) echo "phpstan-diff: unknown option: $1" >&2; exit 2 ;;
		*) paths+=("$1") ;;
	esac
	shift
done

case "$format" in
	table|json) ;;
	*) echo "phpstan-diff: --format must be 'table' or 'json'" >&2; exit 2 ;;
esac

if [ ! -x "$FILTER" ]; then
	echo "phpstan-diff: filter script not found or not executable: $FILTER" >&2
	exit 2
fi

# --- Path include/exclude matching (kept in sync with phpstan-diff-filter) ---
# True (0) if repo-relative path $1 matches path/glob pattern $2. A pattern
# matches an exact file, any descendant of a directory (trailing "/" optional),
# or a shell glob (where "*" may span "/", as in "src/*").
pd_match() {
	local file="$1" pattern="${2%/}"
	[[ "$file" == "$pattern" ]] && return 0
	[[ "$file" == "$pattern"/* ]] && return 0
	# shellcheck disable=SC2053  # unquoted RHS is deliberate: glob match.
	[[ "$file" == $pattern ]] && return 0
	return 1
}

# Rewrite the global paths[] array, keeping only entries allowed by includes[]
# (if any) and not blocked by excludes[]. A no-op when neither is set.
pd_apply_path_filters() {
	[ "${#includes[@]}" -eq 0 ] && [ "${#excludes[@]}" -eq 0 ] && return 0
	local kept=() file pattern drop
	for file in ${paths[@]+"${paths[@]}"}; do
		if [ "${#includes[@]}" -gt 0 ]; then
			drop=1
			for pattern in "${includes[@]}"; do pd_match "$file" "$pattern" && { drop=0; break; }; done
			[ "$drop" -eq 0 ] || continue
		fi
		drop=0
		if [ "${#excludes[@]}" -gt 0 ]; then
			for pattern in "${excludes[@]}"; do pd_match "$file" "$pattern" && { drop=1; break; }; done
		fi
		[ "$drop" -eq 0 ] && kept+=("$file")
	done
	paths=( ${kept[@]+"${kept[@]}"} )
}

# --- Resolve the PHPStan analyse command -------------------------------------

# Print the PHPStan binary to use directly: a project-local vendor binary (honoring
# a custom Composer bin-dir), else a global install. Prints nothing if neither.
pd_find_phpstan_binary() {
	local configured_binary
	if [ -n "${COMPOSER_BIN_DIR:-}" ] && [ -x "${COMPOSER_BIN_DIR}/phpstan" ]; then
		echo "${COMPOSER_BIN_DIR}/phpstan"
	elif [ -x "vendor/bin/phpstan" ]; then
		echo "vendor/bin/phpstan"
	elif configured_binary="$(composer config bin-dir 2>/dev/null)" && \
		[ -n "$configured_binary" ] && [ -x "${configured_binary}/phpstan" ]; then
		echo "${configured_binary}/phpstan"
	elif command -v phpstan >/dev/null 2>&1; then
		echo "phpstan"
	fi
}

analyse_command=()
if [ -n "${PHPSTAN_DIFF_ANALYSE_CMD:-}" ]; then
	# Used verbatim; split on whitespace (good enough for "composer phpstan --" etc.).
	# shellcheck disable=SC2206
	analyse_command=( ${PHPSTAN_DIFF_ANALYSE_CMD} )
elif command -v composer >/dev/null 2>&1 && \
	composer run-script --list 2>/dev/null | grep -qE '^[[:space:]]+phpstan([[:space:]]|$)'; then
	analyse_command=( composer phpstan -- )
else
	phpstan_binary="$(pd_find_phpstan_binary)"
	if [ -n "$phpstan_binary" ]; then
		analyse_command=( "$phpstan_binary" analyse --memory-limit=2G )
	else
		echo "phpstan-diff: could not find PHPStan." >&2
		echo "  Install it (composer require --dev phpstan/phpstan), add a 'phpstan' Composer script," >&2
		echo "  or set PHPSTAN_DIFF_ANALYSE_CMD to the command that runs it." >&2
		exit 2
	fi
fi

# Set the global dump_command[] to a `phpstan dump-parameters --json` invocation
# that resolves the same configuration as analyse_command[], so the filter can tell
# which files PHPStan's excludePaths skipped. Finds the phpstan binary and any
# -c/--configuration among the analyse command's words (or, for the Composer
# script, the script's own words); leaves dump_command empty if it can't.
pd_resolve_dump_command() {
	dump_command=()
	local words=() word binary="" configuration=() expect_configuration=0
	if [ "${analyse_command[0]}" = "composer" ]; then
		# A string script, e.g. "@php ./vendor/bin/phpstan analyse --memory-limit=2G".
		read -r -a words <<< "$(composer config scripts.phpstan 2>/dev/null || true)"
	else
		words=( "${analyse_command[@]}" )
	fi
	for word in ${words[@]+"${words[@]}"}; do
		if [ "$expect_configuration" -eq 1 ]; then
			configuration=( -c "$word" ); expect_configuration=0; continue
		fi
		case "$word" in
			-c|--configuration) expect_configuration=1 ;;
			--configuration=*) configuration=( -c "${word#--configuration=}" ) ;;
			-c?*) configuration=( -c "${word#-c}" ) ;;
			*) case "${word##*/}" in phpstan|phpstan.phar) binary="$word" ;; esac ;;
		esac
	done
	[ -n "$binary" ] || binary="$(pd_find_phpstan_binary)"
	[ -n "$binary" ] || return 0
	dump_command=( "$binary" dump-parameters --json ${configuration[@]+"${configuration[@]}"} )
}

# Print the filter's "no errors" report for an empty result, with a note saying
# why nothing was analysed ($1: no-changed-files | excluded-by-config).
pd_report_nothing_analysed() {
	local nothing_filter_arguments=( "${base_filter_arguments[@]}" --format="$format" --nothing-analysed="$1" )
	[ "$staged" -eq 1 ] && nothing_filter_arguments+=( --staged )
	[ "${#paths[@]}" -gt 0 ] && nothing_filter_arguments+=( -- "${paths[@]}" )
	printf '{"totals":{"errors":0,"file_errors":0},"files":{},"errors":[]}' \
		| "$FILTER" "${nothing_filter_arguments[@]}"
}

# --- Clean up on exit --------------------------------------------------------

# Temporary directories and background jobs to clean up on exit, including on
# Ctrl-C. Background jobs ignore SIGINT, so they're stopped explicitly: a job
# started in its own process group (see --fetch) is stopped along with
# everything it started, e.g. a git fetch and its ssh waiting on a remote.
cleanup_directories=()
cleanup_pids=()
pd_cleanup() {
	local pid
	for pid in ${cleanup_pids[@]+"${cleanup_pids[@]}"}; do
		kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
	done
	if [ "${#cleanup_directories[@]}" -gt 0 ]; then
		rm -rf "${cleanup_directories[@]}"
	fi
	return 0
}
trap pd_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# --- Resolve the base ---------------------------------------------------------

# Print "<is-upstream> <remote> <remote-ref> <tracking-ref>" for each
# remote-tracking counterpart of branch $1 worth considering: the local branch's
# configured upstream (is-upstream 1), then $1 on the conventional "origin" and
# "upstream" remotes. Other remotes (a collaborator's fork, say) are left out,
# since their branch may well have merged this branch's own commits. The
# tracking refs needn't exist yet (so --fetch can create them); callers check.
pd_remote_counterparts() {
	local branch="$1" upstream="" upstream_remote="" upstream_remote_ref="" remote remotes
	if git show-ref --verify --quiet "refs/heads/$branch"; then
		read -r upstream upstream_remote upstream_remote_ref <<< \
			"$(git for-each-ref --format='%(upstream) %(upstream:remotename) %(upstream:remoteref)' "refs/heads/$branch" 2>/dev/null)"
		# (A remote name of "." means the upstream is another local branch.)
		if [ -n "$upstream_remote" ] && [ "$upstream_remote" != "." ] && [[ "$upstream" == refs/remotes/* ]]; then
			echo "1 $upstream_remote $upstream_remote_ref $upstream"
		fi
	fi
	remotes=" $(git remote 2>/dev/null | tr '\n' ' ') "
	for remote in origin upstream; do
		[[ "$remotes" == *" $remote "* ]] && [ "refs/remotes/$remote/$branch" != "$upstream" ] || continue
		echo "0 $remote refs/heads/$branch refs/remotes/$remote/$branch"
	done
}

# Print the remote whose remote-tracking branches $1 (e.g. "upstream/trunk") is
# named under, matching the longest remote name since names may contain "/".
pd_remote_of() {
	local name match=""
	while IFS= read -r name; do
		if [ -n "$name" ] && [[ "$1" == "$name/"?* ]] && [ "${#name}" -gt "${#match}" ]; then
			match="$name"
		fi
	done < <(git remote 2>/dev/null)
	echo "$match"
}

# The environment for --fetch, set up by pd_setup_fetch_environment, so that it
# never waits on a prompt (for a username, password, passphrase or host key): a
# remote that needs credentials, or doesn't answer, should just fail. Stored
# credentials (e.g. a keychain helper) still work. GIT_ASKPASS=false overrides
# any askpass program (an IDE's, or core.askPass), and with terminal prompts off
# git then gives up; GCM_INTERACTIVE=never keeps Git Credential Manager from
# showing a login window. LC_ALL=C keeps git's messages in English for the
# "couldn't find remote ref" match in pd_fetch.
fetch_environment=( LC_ALL=C GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=false GCM_INTERACTIVE=never )
pd_setup_fetch_environment() {
	local ssh_command word
	# The ssh command git would use: GIT_SSH_COMMAND, else GIT_SSH (a program,
	# without arguments), else core.sshCommand, else ssh.
	if [ -n "${GIT_SSH_COMMAND:-}" ]; then
		ssh_command="$GIT_SSH_COMMAND"
	elif [ -n "${GIT_SSH:-}" ]; then
		ssh_command="$(printf '%q' "$GIT_SSH")"
	else
		ssh_command="$(git config core.sshCommand 2>/dev/null || echo ssh)"
	fi
	# If it's OpenSSH, possibly behind a wrapper such as "env FOO=1 ssh -i key",
	# add BatchMode and a connect timeout (at the end, as options to ssh). Other
	# programs, e.g. plink, are left alone, since they may not take these options.
	# shellcheck disable=SC2086  # Deliberate word splitting.
	for word in $ssh_command; do
		case "${word##*/}" in
			ssh|ssh.exe)
				fetch_environment+=( GIT_SSH_COMMAND="$ssh_command -o BatchMode=yes -o ConnectTimeout=10" )
				return 0
				;;
		esac
	done
	return 0
}

# Fetch <remote-ref> from <remote> into <tracking-ref> ($1..$3), printing any
# warning to stderr. Not fatal: on failure (e.g. offline) the existing refs still
# work. With $4 = optional, a remote that simply doesn't have the branch is
# skipped without a warning. --no-write-fetch-head keeps fetches running in
# parallel from fighting over FETCH_HEAD; a stalled HTTP(S) transfer (or one
# that never connects) gives up after 15 seconds.
pd_fetch() {
	local remote="$1" remote_ref="$2" tracking_ref="$3" optional="${4:-}" output status=0
	output="$(env "${fetch_environment[@]}" git -c http.lowSpeedLimit=1 -c http.lowSpeedTime=15 \
		fetch --quiet --no-write-fetch-head "$remote" "+$remote_ref:$tracking_ref" </dev/null 2>&1)" || status=$?
	[ "$status" -eq 0 ] && return 0
	if [ -n "$optional" ] && [[ "$output" == *"couldn't find remote ref"* ]]; then
		return 0
	fi
	echo "phpstan-diff: --fetch: could not fetch $remote_ref from $remote; continuing with the existing refs." >&2
	[ -n "$output" ] && printf '%s\n' "$output" | sed 's/^/  /' >&2
	return 0
}

requested_base="$base"
base_is_local_branch=0
git show-ref --verify --quiet "refs/heads/$base" 2>/dev/null && base_is_local_branch=1
base_is_commit=0
git rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1 && base_is_commit=1

# A remote-tracking base (e.g. --base=upstream/trunk), recognized by name even
# before it's been fetched, as "<remote>/<branch>" for a known remote.
remote_tracking_ref=""
remote_tracking_remote=""
if [ "$base_is_local_branch" -eq 0 ]; then
	full_ref="$(git rev-parse --symbolic-full-name "$base" 2>/dev/null || true)"
	if [[ "$full_ref" == refs/remotes/* ]]; then
		remote_tracking_remote="$(pd_remote_of "${full_ref#refs/remotes/}")"
		[ -n "$remote_tracking_remote" ] && remote_tracking_ref="$full_ref"
	elif [ "$base_is_commit" -eq 0 ]; then
		remote_tracking_remote="$(pd_remote_of "$base")"
		[ -n "$remote_tracking_remote" ] && remote_tracking_ref="refs/remotes/$base"
	fi
fi

# Remote-tracking counterparts are considered for a local branch, and for a
# branch name that only exists on remotes (e.g. a CI clone with origin/trunk
# but no local trunk). Worked out once, before --fetch, which may create them.
counterparts=()   # "<is-upstream> <remote> <remote-ref> <tracking-ref>"
if [ "$base_is_local_branch" -eq 1 ] || {
	[ "$base_is_commit" -eq 0 ] && [ -z "$remote_tracking_ref" ] && git check-ref-format --branch "$base" >/dev/null 2>&1
}; then
	while IFS= read -r counterpart; do
		[ -n "$counterpart" ] && counterparts+=( "$counterpart" )
	done < <(pd_remote_counterparts "$base")
fi

# --fetch runs first, so that refs it creates are considered below. Each remote
# gets one job, which fetches its refs one at a time; the jobs for different
# remotes run in parallel, so an unreachable remote costs one timeout, not one
# per ref. In a shallow clone, or with the reftable ref backend, where
# concurrent fetches contend for one lock, they run one at a time instead.
if [ "$fetch" -eq 1 ]; then
	fetches=()   # "<remote> <remote-ref> <tracking-ref> [optional]"
	for counterpart in ${counterparts[@]+"${counterparts[@]}"}; do
		read -r is_upstream remote remote_ref tracking_ref <<< "$counterpart"
		# Only the upstream is expected to exist; other remotes may lack the branch.
		optional=optional
		[ "$is_upstream" = 1 ] && optional=""
		fetches+=( "$remote $remote_ref $tracking_ref $optional" )
	done
	if [ -n "$remote_tracking_ref" ]; then
		fetches+=( "$remote_tracking_remote refs/heads/${remote_tracking_ref#"refs/remotes/$remote_tracking_remote/"} $remote_tracking_ref" )
	fi
	if [ "${#fetches[@]}" -eq 0 ]; then
		echo "phpstan-diff: --fetch: '$base' has no remote-tracking branch to fetch." >&2
	else
		pd_setup_fetch_environment
		parallel=1
		if [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = true ] || \
			[ "$(git config extensions.refStorage 2>/dev/null)" = reftable ]; then
			parallel=0
		fi
		fetch_remotes=()   # In order of first appearance.
		for entry in "${fetches[@]}"; do
			remote="${entry%% *}"
			case " ${fetch_remotes[*]-} " in *" $remote "*) ;; *) fetch_remotes+=( "$remote" ) ;; esac
		done
		fetch_directory="$(mktemp -d "${TMPDIR:-/tmp}/phpstan-diff-fetch.XXXXXX")"
		cleanup_directories+=( "$fetch_directory" )
		# (Job control gives each background job its own process group, which
		# pd_cleanup can stop as a whole.)
		[ "$parallel" -eq 1 ] && set -m
		for index in "${!fetch_remotes[@]}"; do
			job_remote="${fetch_remotes[$index]}"
			if [ "$parallel" -eq 1 ]; then
				(
					for entry in "${fetches[@]}"; do
						read -r remote remote_ref tracking_ref optional <<< "$entry"
						[ "$remote" = "$job_remote" ] && pd_fetch "$remote" "$remote_ref" "$tracking_ref" "$optional"
					done
					exit 0
				) 2>"$fetch_directory/$index" &
				cleanup_pids+=( $! )
			else
				for entry in "${fetches[@]}"; do
					read -r remote remote_ref tracking_ref optional <<< "$entry"
					[ "$remote" = "$job_remote" ] && pd_fetch "$remote" "$remote_ref" "$tracking_ref" "$optional" 2>>"$fetch_directory/$index"
				done
			fi
		done
		set +m
		[ "${#cleanup_pids[@]}" -gt 0 ] && { wait "${cleanup_pids[@]}" || true; }
		cleanup_pids=()
		# Print any warnings in order, rather than interleaved.
		for index in "${!fetch_remotes[@]}"; do
			[ -f "$fetch_directory/$index" ] && cat "$fetch_directory/$index" >&2
		done
	fi
fi

# Candidate bases: the requested base itself (unless it's a branch that only
# exists on remotes), then its remote-tracking counterparts. Full refs avoid
# ambiguity, e.g. with a tag of the same name. (Two arrays rather than one of
# "<name> <ref>" strings, since a revision such as "trunk@{1 week ago}" may
# contain spaces.)
candidate_names=()
candidate_refs=()
requested_ref=""
if [ "$base_is_local_branch" -eq 1 ]; then
	requested_ref="refs/heads/$base"
elif [ -n "$remote_tracking_ref" ]; then
	requested_ref="$remote_tracking_ref"
elif [ "${#counterparts[@]}" -eq 0 ]; then
	requested_ref="$base"
fi
if [ -n "$requested_ref" ] && git rev-parse --verify --quiet "$requested_ref^{commit}" >/dev/null; then
	candidate_names+=( "$base" )
	candidate_refs+=( "$requested_ref" )
fi
for counterpart in ${counterparts[@]+"${counterparts[@]}"}; do
	read -r _ _ _ tracking_ref <<< "$counterpart"
	if git show-ref --verify --quiet "$tracking_ref"; then
		candidate_names+=( "${tracking_ref#refs/remotes/}" )
		candidate_refs+=( "$tracking_ref" )
	fi
done
if [ "${#candidate_refs[@]}" -eq 0 ]; then
	echo "phpstan-diff: base '$base' is not a valid commit or branch (see --base)." >&2
	exit 2
fi

# Work out what to diff against. Every candidate's merge-base with HEAD is in
# this branch's history, and the commits behind it normally aren't this branch's
# changes (e.g. commits that origin/trunk has, and this branch merged, but the
# local trunk lacks). So take the newest: the merge-base(s) that no other one
# contains. If several remain (say, this branch merged both origin/trunk with
# fork-only commits and a newer upstream/trunk), a line counts as changed only
# if it changed relative to all of them.
#
# A candidate whose merge-base is HEAD itself (e.g. a trunk that this branch has
# already been merged into) would hide every change, so it's skipped, unless
# every candidate is like that (e.g. --base=HEAD), or it's the branch that is
# checked out (on trunk, the diff is against trunk itself: uncommitted changes).
head_commit="$(git rev-parse --verify --quiet HEAD || true)"
head_branch="$(git symbolic-ref --quiet HEAD 2>/dev/null || true)"
candidate_merge_bases=()   # Parallel to candidate_refs; empty if none.
has_older_merge_base=0
requested_merge_base=""
for index in "${!candidate_refs[@]}"; do
	candidate_merge_base="$(git merge-base "${candidate_refs[$index]}" HEAD 2>/dev/null || true)"
	candidate_merge_bases+=( "$candidate_merge_base" )
	if [ -n "$candidate_merge_base" ] && [ "$candidate_merge_base" != "$head_commit" ]; then
		has_older_merge_base=1
	fi
	[ "${candidate_refs[$index]}" = "$requested_ref" ] && requested_merge_base="$candidate_merge_base"
done

# "<merge-base> <name>" for each merge-base kept (the first name wins), with the
# name last since it may contain spaces.
merge_base_entries=()
for index in "${!candidate_refs[@]}"; do
	candidate_merge_base="${candidate_merge_bases[$index]}"
	[ -n "$candidate_merge_base" ] || continue
	if [ "$has_older_merge_base" -eq 1 ] && [ "$candidate_merge_base" = "$head_commit" ] && \
		[ "${candidate_refs[$index]}" != "$head_branch" ]; then
		continue
	fi
	case " ${merge_base_entries[*]-} " in *" $candidate_merge_base "*) continue ;; esac
	merge_base_entries+=( "$candidate_merge_base ${candidate_names[$index]}" )
done

# Keep the newest: those no other one contains (in candidate order).
used_entries=()
if [ "${#merge_base_entries[@]}" -gt 0 ]; then
	merge_base_commits=()
	for entry in "${merge_base_entries[@]}"; do merge_base_commits+=( "${entry%% *}" ); done
	independent=" $(git merge-base --independent "${merge_base_commits[@]}" | tr '\n' ' ') "
	for entry in "${merge_base_entries[@]}"; do
		[[ "$independent" == *" ${entry%% *} "* ]] && used_entries+=( "$entry" )
	done
else
	# No merge-base at all (unrelated histories): diff against the base itself.
	used_entries+=( "$(git rev-parse --verify --quiet "${candidate_refs[0]}^{commit}") ${candidate_names[0]}" )
fi

used_names=""   # E.g. "upstream/trunk", or "upstream/trunk + origin/trunk".
for entry in "${used_entries[@]}"; do used_names="${used_names:+$used_names + }${entry#* }"; done
base_note=""    # Why the base used differs from the requested one, if it does.
if [ "${#used_entries[@]}" -gt 1 ]; then
	base_note="This branch merged $used_names, whose histories have diverged, so only lines changed relative to all of them count."
elif [ "$used_names" != "$requested_base" ] && [ -n "$requested_ref" ]; then
	# (A base that only exists on remotes, as in CI, needs no note.)
	if [ -z "$requested_merge_base" ]; then
		base_note="The local $requested_base shares no history with this branch, so the diff is against $used_names instead."
	elif [ "$requested_merge_base" = "$head_commit" ]; then
		base_note="The local $requested_base already contains this branch, so the diff is against $used_names instead."
	else
		base_note="This branch contains commits from $used_names that the local $requested_base lacks, so the diff is against $used_names instead."
	fi
fi
if [ -n "$base_note" ] && [ "$base_is_local_branch" -eq 1 ]; then
	base_note="${base_note%.} (to use $requested_base as-is, pass --base=refs/heads/$requested_base)."
fi

base_filter_arguments=( --base="$requested_base" )
for entry in "${used_entries[@]}"; do base_filter_arguments+=( --used-base="$entry" ); done
[ -n "$base_note" ] && base_filter_arguments+=( --base-note="$base_note" )
diff_targets=()
for entry in "${used_entries[@]}"; do diff_targets+=( "${entry%% *}" ); done

# --- Narrow analysis to changed files (unless --whole-project) ----------------

if [ "$whole_project" -eq 0 ] && [ "${#paths[@]}" -eq 0 ]; then
	# Always diff against the merge-base; --staged just compares the index
	# (staged snapshot) instead of the working tree. With several merge-bases, a
	# file is in scope only if it changed relative to all of them.
	diff_options=( --name-only --diff-filter=ACMR )
	[ "$staged" -eq 1 ] && diff_options+=( --cached )
	changed_files="$(git diff "${diff_options[@]}" "${diff_targets[0]}" -- '*.php' 2>/dev/null || true)"
	for commit in "${diff_targets[@]:1}"; do
		changed_files="$(comm -12 <(printf '%s\n' "$changed_files" | sort) \
			<(git diff "${diff_options[@]}" "$commit" -- '*.php' 2>/dev/null | sort))"
	done
	while IFS= read -r file; do
		[ -n "$file" ] && paths+=("$file")
	done <<< "$changed_files"
	# Drop changed files that fall outside --include / inside --exclude so PHPStan
	# never analyses them (the faster path), not just hides their errors later.
	pd_apply_path_filters
	if [ "${#paths[@]}" -eq 0 ]; then
		# Nothing in scope — let the filter print the friendly "no errors" message.
		pd_report_nothing_analysed no-changed-files
		exit $?
	fi
fi

# --- Run PHPStan and filter --------------------------------------------------

phpstan_arguments=( --error-format=json --no-progress )
if [ "${#paths[@]}" -gt 0 ]; then
	phpstan_arguments+=( -- "${paths[@]}" )
fi

# Keep PHPStan's stderr so a failure can be explained without re-running it.
work_directory="$(mktemp -d "${TMPDIR:-/tmp}/phpstan-diff.XXXXXX")"
stderr_file="$work_directory/stderr"
parameters_file="$work_directory/parameters.json"
cleanup_directories+=( "$work_directory" )
dump_pid=""

# When PHPStan is handed specific files, it silently skips any its excludePaths
# cover. Dump its resolved parameters alongside the analysis (in the background,
# since it boots PHPStan too) so the filter can name the skipped files.
if [ "${#paths[@]}" -gt 0 ]; then
	pd_resolve_dump_command
	if [ "${#dump_command[@]}" -gt 0 ]; then
		"${dump_command[@]}" >"$parameters_file" 2>/dev/null </dev/null &
		dump_pid=$!
		cleanup_pids+=( "$dump_pid" )
	fi
fi

# PHPStan exits 1 when it finds errors; that's expected, so don't let set -e abort.
json="$("${analyse_command[@]}" "${phpstan_arguments[@]}" 2>"$stderr_file" || true)"

# Sanity-check that we got a JSON document — in pure bash, so a multi-megabyte
# $json can't trigger SIGPIPE on a `head`/`grep` pipeline under `set -o pipefail`.
json_head="${json#"${json%%[![:space:]]*}"}"   # strip any leading whitespace
if [ "${json_head:0:1}" != "{" ]; then
	# When PHPStan's excludePaths covers every path it was handed, it emits no JSON,
	# just "[ERROR] No files found to analyse." (A partially excluded set is fine:
	# the excluded paths are silently skipped.) That's not a failure of the change.
	if [ "${#paths[@]}" -gt 0 ] && { grep -q 'No files found to analyse' "$stderr_file" || [[ "$json" == *'No files found to analyse'* ]]; }; then
		pd_report_nothing_analysed excluded-by-config
		exit $?
	fi
	echo "phpstan-diff: PHPStan did not produce JSON output:" >&2
	[ -n "$json" ] && printf '%s\n' "$json" >&2
	cat "$stderr_file" >&2
	exit 2
fi

filter_arguments=( "${base_filter_arguments[@]}" --format="$format" )
[ "$staged" -eq 1 ] && filter_arguments+=( --staged )
for pattern in ${includes[@]+"${includes[@]}"}; do filter_arguments+=( --include="$pattern" ); done
for pattern in ${excludes[@]+"${excludes[@]}"}; do filter_arguments+=( --exclude="$pattern" ); done
if [ -n "$dump_pid" ]; then
	wait "$dump_pid" && filter_arguments+=( --phpstan-parameters="$parameters_file" )
	cleanup_pids=()
fi
if [ "${#paths[@]}" -gt 0 ]; then
	filter_arguments+=( -- "${paths[@]}" )
fi

printf '%s' "$json" | "$FILTER" "${filter_arguments[@]}"
