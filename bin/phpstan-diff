#!/usr/bin/env bash
#
# phpstan-diff — run PHPStan and show only the errors on lines this branch
# changed relative to a base branch (default: trunk).
#
# Usage:
#   phpstan-diff [--base=<ref>] [--staged] [--changed] [--format=table|json]
#                [--include=<glob>]... [--exclude=<glob>]... [-- <paths...>]
#
# Options:
#   --base=<ref>      Base ref to diff against (default: $PHPSTAN_DIFF_BASE or "trunk").
#   --staged          Diff the staged snapshot (the git index) against the base
#                     instead of the working tree: errors on committed + staged
#                     changes, with unstaged edits ignored. Add --base=HEAD to
#                     narrow it to staged changes only (e.g. from a pre-commit hook).
#   --changed         When no paths are given, only run PHPStan on the .php files that
#                     differ from the base (fast path for PR review).
#   --include=<glob>  Keep only files matching this repo-relative path or glob; the
#                     match is intersected with the files actually changed. Repeatable
#                     (a file is kept if it matches ANY --include). A bare directory
#                     (e.g. --include=src) matches everything under it. Unlike the
#                     positional <paths>, this is a filter over the changed files, not
#                     a PHPStan analysis target, and it understands globs.
#   --exclude=<glob>  Drop files matching this repo-relative path or glob (e.g.
#                     --exclude=tests). Repeatable; applied after --include, and an
#                     exclude wins over an include. With --changed, excluded files
#                     aren't handed to PHPStan at all (so the run is faster too).
#   --format=table    Human-readable table (default).
#   --format=json     Emit the filtered PHPStan JSON document.
#   -- <paths...>     Restrict PHPStan (and the diff) to these paths (PHPStan analysis
#                     targets; combine with --include/--exclude to filter further).
#
# Environment:
#   PHPSTAN_DIFF_BASE          Default base ref.
#   PHPSTAN_DIFF_ANALYSE_CMD   Command that runs PHPStan analyse. If set, used verbatim
#                              (our extra args are appended). If unset, auto-detected:
#                                1. `composer phpstan --`  (if a "phpstan" Composer script exists)
#                                2. `<vendor-bin>/phpstan analyse --memory-limit=2G`
#                                3. `phpstan analyse --memory-limit=2G`  (global install)
#
# Exit status: 1 if any errors remain after filtering, 0 otherwise, 2 on internal errors.

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
FILTER="$SCRIPT_DIR/phpstan-diff-filter"

base="${PHPSTAN_DIFF_BASE:-trunk}"
staged=0
changed=0
format="table"
paths=()
includes=()
excludes=()
seen_dashdash=0

while [ "$#" -gt 0 ]; do
	if [ "$seen_dashdash" -eq 1 ]; then
		paths+=("$1"); shift; continue
	fi
	case "$1" in
		--) seen_dashdash=1 ;;
		--base=*) base="${1#--base=}" ;;
		--base) shift; base="${1:?--base requires a value}" ;;
		--staged|--cached) staged=1 ;;
		--changed) changed=1 ;;
		--include=*) includes+=("${1#--include=}") ;;
		--include) shift; includes+=("${1:?--include requires a value}") ;;
		--exclude=*) excludes+=("${1#--exclude=}") ;;
		--exclude) shift; excludes+=("${1:?--exclude requires a value}") ;;
		--format=*) format="${1#--format=}" ;;
		--format) shift; format="${1:?--format requires a value}" ;;
		-h|--help) awk 'NR>1{ if (!/^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; exit 0 ;;
		--*) echo "phpstan-diff: unknown option: $1" >&2; exit 2 ;;
		*) paths+=("$1") ;;
	esac
	shift
done

case "$format" in
	table|json) ;;
	*) echo "phpstan-diff: --format must be 'table' or 'json'" >&2; exit 2 ;;
esac

if [ ! -x "$FILTER" ]; then
	echo "phpstan-diff: filter script not found or not executable: $FILTER" >&2
	exit 2
fi

# --- Path include/exclude matching (kept in sync with phpstan-diff-filter) ---
# True (0) if repo-relative path $1 matches path/glob pattern $2. A pattern
# matches an exact file, any descendant of a directory (trailing "/" optional),
# or a shell glob (where "*" may span "/", as in "src/*").
pd_match() {
	local file="$1" pattern="${2%/}"
	[[ "$file" == "$pattern" ]] && return 0
	[[ "$file" == "$pattern"/* ]] && return 0
	# shellcheck disable=SC2053  # unquoted RHS is deliberate: glob match.
	[[ "$file" == $pattern ]] && return 0
	return 1
}

# Rewrite the global paths[] array, keeping only entries allowed by includes[]
# (if any) and not blocked by excludes[]. A no-op when neither is set.
pd_apply_path_filters() {
	[ "${#includes[@]}" -eq 0 ] && [ "${#excludes[@]}" -eq 0 ] && return 0
	local kept=() file pattern drop
	for file in ${paths[@]+"${paths[@]}"}; do
		if [ "${#includes[@]}" -gt 0 ]; then
			drop=1
			for pattern in "${includes[@]}"; do pd_match "$file" "$pattern" && { drop=0; break; }; done
			[ "$drop" -eq 0 ] || continue
		fi
		drop=0
		if [ "${#excludes[@]}" -gt 0 ]; then
			for pattern in "${excludes[@]}"; do pd_match "$file" "$pattern" && { drop=1; break; }; done
		fi
		[ "$drop" -eq 0 ] && kept+=("$file")
	done
	paths=( ${kept[@]+"${kept[@]}"} )
}

# --- Resolve the PHPStan analyse command -------------------------------------

analyse_command=()
if [ -n "${PHPSTAN_DIFF_ANALYSE_CMD:-}" ]; then
	# Used verbatim; split on whitespace (good enough for "composer phpstan --" etc.).
	# shellcheck disable=SC2206
	analyse_command=( ${PHPSTAN_DIFF_ANALYSE_CMD} )
elif command -v composer >/dev/null 2>&1 && \
	composer run-script --list 2>/dev/null | grep -qE '^[[:space:]]+phpstan([[:space:]]|$)'; then
	analyse_command=( composer phpstan -- )
else
	# Find a project-local vendor binary, honoring a custom Composer bin-dir.
	vendor_binary=""
	if [ -n "${COMPOSER_BIN_DIR:-}" ] && [ -x "${COMPOSER_BIN_DIR}/phpstan" ]; then
		vendor_binary="${COMPOSER_BIN_DIR}/phpstan"
	elif [ -x "vendor/bin/phpstan" ]; then
		vendor_binary="vendor/bin/phpstan"
	elif command -v composer >/dev/null 2>&1; then
		configured_binary="$(composer config bin-dir 2>/dev/null || true)"
		if [ -n "$configured_binary" ] && [ -x "${configured_binary}/phpstan" ]; then
			vendor_binary="${configured_binary}/phpstan"
		fi
	fi
	if [ -n "$vendor_binary" ]; then
		analyse_command=( "$vendor_binary" analyse --memory-limit=2G )
	elif command -v phpstan >/dev/null 2>&1; then
		analyse_command=( phpstan analyse --memory-limit=2G )
	else
		echo "phpstan-diff: could not find PHPStan." >&2
		echo "  Install it (composer require --dev phpstan/phpstan), add a 'phpstan' Composer script," >&2
		echo "  or set PHPSTAN_DIFF_ANALYSE_CMD to the command that runs it." >&2
		exit 2
	fi
fi

# --- Optionally narrow analysis to changed files -----------------------------

if [ "$changed" -eq 1 ] && [ "${#paths[@]}" -eq 0 ]; then
	# Always diff against the merge-base; --staged just compares the index
	# (staged snapshot) instead of the working tree.
	merge_base="$(git merge-base "$base" HEAD 2>/dev/null || true)"
	diff_ref_arguments=()
	[ "$staged" -eq 1 ] && diff_ref_arguments+=( --cached )
	diff_ref_arguments+=( "${merge_base:-$base}" )
	while IFS= read -r file; do
		[ -n "$file" ] && paths+=("$file")
	done < <(git diff --name-only --diff-filter=ACMR "${diff_ref_arguments[@]}" -- '*.php' 2>/dev/null)
	# Drop changed files that fall outside --include / inside --exclude so PHPStan
	# never analyses them (the faster path), not just hides their errors later.
	pd_apply_path_filters
	if [ "${#paths[@]}" -eq 0 ]; then
		# Nothing in scope — let the filter print the friendly "no errors" message.
		empty_filter_arguments=( --base="$base" --format="$format" )
		[ "$staged" -eq 1 ] && empty_filter_arguments+=( --staged )
		printf '{"totals":{"errors":0,"file_errors":0},"files":{},"errors":[]}' \
			| "$FILTER" "${empty_filter_arguments[@]}"
		exit $?
	fi
fi

# --- Run PHPStan and filter --------------------------------------------------

phpstan_arguments=( --error-format=json --no-progress )
if [ "${#paths[@]}" -gt 0 ]; then
	phpstan_arguments+=( -- "${paths[@]}" )
fi

# PHPStan exits 1 when it finds errors; that's expected, so don't let set -e abort.
json="$("${analyse_command[@]}" "${phpstan_arguments[@]}" 2>/dev/null || true)"

# Sanity-check that we got a JSON document — in pure bash, so a multi-megabyte
# $json can't trigger SIGPIPE on a `head`/`grep` pipeline under `set -o pipefail`.
json_head="${json#"${json%%[![:space:]]*}"}"   # strip any leading whitespace
if [ "${json_head:0:1}" != "{" ]; then
	echo "phpstan-diff: PHPStan did not produce JSON output. Re-running to show its error:" >&2
	"${analyse_command[@]}" "${phpstan_arguments[@]}" >&2 || true
	exit 2
fi

filter_arguments=( --base="$base" --format="$format" )
[ "$staged" -eq 1 ] && filter_arguments+=( --staged )
for pattern in ${includes[@]+"${includes[@]}"}; do filter_arguments+=( --include="$pattern" ); done
for pattern in ${excludes[@]+"${excludes[@]}"}; do filter_arguments+=( --exclude="$pattern" ); done
if [ "${#paths[@]}" -gt 0 ]; then
	filter_arguments+=( -- "${paths[@]}" )
fi

printf '%s' "$json" | "$FILTER" "${filter_arguments[@]}"