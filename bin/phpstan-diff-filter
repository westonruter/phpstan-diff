#!/usr/bin/env php
<?php

/**
 * phpstan-diff-filter — read a PHPStan JSON report on stdin, keep only the
 * messages that fall on lines this branch changed relative to a base ref,
 * print them (as a PHPStan-style table or as JSON), and exit 1 if any remain.
 * phpstan-diff does this itself; this is for when PHPStan is run some other way.
 *
 * Usage:
 *   <phpstan> --error-format=json ... | phpstan-diff-filter \
 *       [--base=<ref>] [--staged] [--no-ignore-whitespace] [--format=table|json] \
 *       [--include=<glob>]... [--exclude=<glob>]... [--level=<level>] \
 *       [--phpstan-parameters=<file>] [-- <paths...>]
 *
 * The diff is against `git merge-base <base> HEAD` (or <base> itself if there is
 * none). Unlike phpstan-diff, the filter doesn't look at <base>'s
 * remote-tracking counterparts (see phpstan-diff's --base). With --format=json,
 * the base is reported under "phpstan_diff"."base" in the output document.
 *
 * <paths> restrict the diff to those paths (pass what PHPStan was given).
 *
 * --phpstan-parameters names a file holding `phpstan dump-parameters --json`
 * output; any <paths> its excludePaths cover are listed in a note as not analyzed
 * (PHPStan skips them silently). If the file can't be parsed, no note is shown.
 *
 * --level=<level> says that PHPStan was run with --level=<level>, overriding its
 * configuration's level. As with phpstan-diff's --level, errors about ignores
 * that don't fit it are then left out: all of them if the level is lower than the
 * configuration's (as --phpstan-parameters tells; without it, any level but max
 * counts as lower), else just those about a baseline count that's off.
 *
 * --include/--exclude keep or drop reported files by repo-relative path or glob,
 * intersected with the changed files. A bare directory (e.g. --include=src)
 * matches everything under it; "*" in a glob may span "/". A file is kept if it
 * matches any --include (when given) and no --exclude (exclude wins).
 *
 * Diff scope:
 *   default   git diff $(git merge-base <base> HEAD)  — every line that differs
 *             from where the branch diverged from <base>, including staged and
 *             unstaged working-tree edits. <base> defaults to $PHPSTAN_DIFF_BASE
 *             or the default branch (as for phpstan-diff).
 *   --staged  git diff --cached $(git merge-base <base> HEAD)  — diffs the staged
 *             snapshot (the git index) instead of the working tree: committed +
 *             staged changes, with unstaged edits ignored. Add --base=HEAD to
 *             narrow it to staged changes only (for pre-commit hooks).
 *             Note: PHPStan still analyzes the working tree, not the staged blob.
 *
 * Lines whose only changes are in the amount of whitespace (re-indentation,
 * trailing spaces) don't count as changed, as with `git diff -b`, unless
 * --no-ignore-whitespace is given. A note says how many errors that hides, since
 * they may be new all the same (e.g. in code moved into a closure); they don't
 * affect the exit status.
 *
 * Limitation: messages with no line, or a line outside every changed hunk
 * (e.g. some file-level "class not found" errors), are dropped.
 *
 * Exit status: 1 if any errors remain after filtering, 0 if none, 2 on internal errors.
 *
 * @package   WestonRuter\PHPStanDiff
 * @author    Weston Ruter
 * @copyright 2026 Weston Ruter
 * @license   https://opensource.org/license/mit MIT
 * @link      https://github.com/westonruter/phpstan-diff
 */

declare(strict_types=1);

namespace WestonRuter\PHPStanDiff;

if (PHP_VERSION_ID < 80200) {
	// (Checked before loading the code, which needs PHP 8.2 even to be parsed.)
	fwrite(STDERR, basename(__FILE__) . ": PHP 8.2 or later is required (this is PHP " . PHP_VERSION . ").\n");
	exit(2);
}

require __DIR__ . '/../src/load.php';

program('phpstan-diff-filter');

// --- Parse arguments ---------------------------------------------------------

$base             = null; // Default: default_base().
$staged           = false;
$ignoreWhitespace = true;
$format           = Format::Table;
$paths            = [];
$includes         = [];
$excludes         = [];
$parametersFile   = null;
$level            = null;

/** @var list<string> $argv */
$arguments     = array_slice($argv, 1);
$argumentCount = count($arguments);
for ($index = 0; $index < $argumentCount; $index++) {
	$argument = $arguments[$index];
	if ($argument === '--') {
		array_push($paths, ...array_slice($arguments, $index + 1));
		break;
	}
	$options = 'base|include|exclude|format|level|phpstan-parameters';
	if (preg_match("/^--($options)(?:=(.*))?\$/s", $argument, $matches) === 1) {
		if (!isset($matches[2])) {
			if (!isset($arguments[$index + 1])) {
				fail("--{$matches[1]} requires a value");
			}
			$matches[2] = $arguments[++$index];
		}
		if ($matches[1] === 'base') {
			$base = $matches[2];
		} elseif ($matches[1] === 'include') {
			$includes[] = $matches[2];
		} elseif ($matches[1] === 'exclude') {
			$excludes[] = $matches[2];
		} elseif ($matches[1] === 'level') {
			$level = $matches[2];
		} elseif ($matches[1] === 'format') {
			$format = Format::tryFrom($matches[2]) ?? fail("--format must be 'table' or 'json'");
		} else {
			$parametersFile = $matches[2];
		}
	} elseif ($argument === '--staged' || $argument === '--cached') {
		$staged = true;
	} elseif ($argument === '--ignore-whitespace' || $argument === '--no-ignore-whitespace') {
		$ignoreWhitespace = $argument === '--ignore-whitespace';
	} elseif ($argument === '-h' || $argument === '--help') {
		print_usage(__FILE__);
		exit(ExitStatus::Ok->value);
	} elseif (str_starts_with($argument, '--')) {
		fail("unknown option: $argument");
	} else {
		$paths[] = $argument;
	}
}
if ($base === '') {
	fail('--base must not be empty');
}
$level = $level !== null && $level !== '' ? analysis_level($level) : null;
top_level(); // Fails outside a git repository.
$base ??= default_base();

// --- Read the PHPStan JSON report from stdin --------------------------------

$rawReport = stream_get_contents(STDIN);
if (!is_string($rawReport) || trim($rawReport) === '') {
	fail('no input on stdin (expected PHPStan JSON output)');
}
$report = decode_report($rawReport);
if ($report === null) {
	fail('stdin is not valid JSON (run PHPStan with --error-format=json)');
}

$excludedPaths = [];
$configured    = null;
if ($parametersFile !== null) {
	$phpstanParameters = @file_get_contents($parametersFile);
	$workingDirectory  = getcwd();
	if (is_string($phpstanParameters)) {
		$configured    = configured_level($phpstanParameters);
		$excludedPaths = excluded_paths(
			$paths,
			$phpstanParameters,
			$workingDirectory !== false ? $workingDirectory : top_level(),
		);
	}
}

exit(filter_report($report, [
	'base'             => $base,
	'staged'           => $staged,
	'ignoreWhitespace' => $ignoreWhitespace,
	'format'           => $format,
	'paths'            => $paths,
	'includes'         => $includes,
	'excludes'         => $excludes,
	'excludedPaths'    => $excludedPaths,
	'level'            => $level,
	'levelAtLeastConfigured' => $level !== null && level_at_least($level, $configured),
])->value);
