#!/usr/bin/env php
<?php
/**
 * phpstan-diff-filter — read a PHPStan JSON report on stdin, keep only the
 * messages that fall on lines this branch changed relative to a base ref,
 * print them (as a PHPStan-style table or as JSON), and exit 1 if any remain.
 *
 * Usage:
 *   <phpstan> --error-format=json ... | phpstan-diff-filter \
 *       [--base=<ref>] [--staged] [--format=table|json] \
 *       [--include=<glob>]... [--exclude=<glob>]... [-- <paths...>]
 *
 * --include/--exclude keep or drop reported files by repo-relative path or glob,
 * intersected with the changed files. A bare directory (e.g. --include=src)
 * matches everything under it; "*" in a glob may span "/". A file is kept if it
 * matches any --include (when given) and no --exclude (exclude wins).
 *
 * Diff scope:
 *   default   git diff $(git merge-base <base> HEAD)  — every line that differs
 *             from where the branch diverged from <base>, including staged and
 *             unstaged working-tree edits. <base> defaults to $PHPSTAN_DIFF_BASE
 *             or "trunk".
 *   --staged  git diff --cached $(git merge-base <base> HEAD)  — diffs the staged
 *             snapshot (the git index) instead of the working tree: committed +
 *             staged changes, with unstaged edits ignored. Add --base=HEAD to
 *             narrow it to staged changes only (for pre-commit hooks).
 *             Note: PHPStan still analyses the working tree, not the staged blob.
 *
 * Limitation: messages with no line, or a line outside every changed hunk
 * (e.g. some file-level "class not found" errors), are dropped.
 *
 * Exit status: 1 if any errors remain after filtering, 0 if none, 2 on internal errors.
 */

declare(strict_types=1);

use JetBrains\PhpStorm\NoReturn;

const PD_EXIT_OK       = 0;
const PD_EXIT_ERRORS   = 1;
const PD_EXIT_INTERNAL = 2;

/**
 * Print a fatal error and exit.
 */
#[NoReturn]
function pd_fail(string $message): void {
	fwrite(STDERR, "phpstan-diff-filter: $message\n");
	exit(PD_EXIT_INTERNAL);
}

/**
 * Run a git command, returning its stdout split into lines (newlines stripped).
 *
 * @param list<string> $arguments
 */
function pd_git(array $arguments, ?int &$exitCode = null): array {
	$command = 'git';
	foreach ($arguments as $argument) {
		$command .= ' ' . escapeshellarg($argument);
	}
	$command .= ' 2>/dev/null';
	$output = array();
	$status = 0;
	exec($command, $output, $status);
	$exitCode = $status;
	return $output;
}

/**
 * Resolve the "+++ " path from a unified-diff file header to a repo-relative
 * path, or null when the new side is /dev/null (a deleted file).
 */
function pd_parse_header_path(string $path): ?string {
	$tabPosition = strpos($path, "\t");
	if ($tabPosition !== false) {
		$path = substr($path, 0, $tabPosition);
	}
	if ($path === '/dev/null') {
		return null;
	}
	if (strlen($path) >= 2 && $path[0] === '"' && str_ends_with($path, '"')) {
		$path = stripcslashes(substr($path, 1, -1));
	}
	if (str_starts_with($path, 'b/')) {
		$path = substr($path, 2);
	}
	return $path;
}

/**
 * Wrap a string in an ANSI SGR sequence when color is enabled.
 */
function pd_style(string $text, string $codes, bool $enabled): string {
	return $enabled ? "\033[{$codes}m$text\033[0m" : $text;
}

/**
 * Express $path relative to $base when possible.
 */
function pd_relative_to(string $path, string $base): string {
	$base = rtrim($base, '/');
	if ($base !== '' && str_starts_with($path, $base . '/')) {
		return substr($path, strlen($base) + 1);
	}
	return $path;
}

/**
 * True if repo-relative $file matches the path/glob $pattern: an exact file, any
 * descendant of a directory (trailing "/" optional), or a glob (where "*" may
 * span "/"). Kept in sync with pd_match() in the phpstan-diff wrapper.
 */
function pd_path_matches(string $file, string $pattern): bool {
	$trimmedPattern = rtrim($pattern, '/');
	if ($file === $trimmedPattern) {
		return true;
	}
	if ($trimmedPattern !== '' && str_starts_with($file, $trimmedPattern . '/')) {
		return true;
	}
	return fnmatch($trimmedPattern, $file);
}

// --- Parse arguments ---------------------------------------------------------

$base     = getenv('PHPSTAN_DIFF_BASE');
$base     = (is_string($base) && $base !== '') ? $base : 'trunk';
$staged   = false;
$format   = 'table';
$paths    = array();
$includes = array();
$excludes = array();

$arguments     = array_slice($argv, 1);
$afterDash     = false;
$argumentCount = count($arguments);
for ($index = 0; $index < $argumentCount; $index++) {
	$argument = $arguments[$index];
	if ($afterDash) {
		$paths[] = $argument;
		continue;
	}
	if ($argument === '--') {
		$afterDash = true;
	} elseif ($argument === '--staged' || $argument === '--cached') {
		$staged = true;
	} elseif (str_starts_with($argument, '--base=')) {
		$base = substr($argument, 7);
	} elseif ($argument === '--base') {
		if (!isset($arguments[$index + 1])) {
			pd_fail('--base requires a value');
		}
		$base = $arguments[++$index];
	} elseif (str_starts_with($argument, '--include=')) {
		$includes[] = substr($argument, 10);
	} elseif ($argument === '--include') {
		if (!isset($arguments[$index + 1])) {
			pd_fail('--include requires a value');
		}
		$includes[] = $arguments[++$index];
	} elseif (str_starts_with($argument, '--exclude=')) {
		$excludes[] = substr($argument, 10);
	} elseif ($argument === '--exclude') {
		if (!isset($arguments[$index + 1])) {
			pd_fail('--exclude requires a value');
		}
		$excludes[] = $arguments[++$index];
	} elseif (str_starts_with($argument, '--format=')) {
		$format = substr($argument, 9);
	} elseif ($argument === '--format') {
		if (!isset($arguments[$index + 1])) {
			pd_fail('--format requires a value');
		}
		$format = $arguments[++$index];
	} elseif (str_starts_with($argument, '--')) {
		pd_fail("unknown option: $argument");
	} else {
		$paths[] = $argument;
	}
}
if ($format !== 'table' && $format !== 'json') {
	pd_fail("--format must be 'table' or 'json'");
}

// --- Read the PHPStan JSON report from stdin --------------------------------

$rawReport = stream_get_contents(STDIN);
if (!is_string($rawReport) || trim($rawReport) === '') {
	pd_fail('no input on stdin (expected PHPStan JSON output)');
}
$report = json_decode($rawReport, true);
if (!is_array($report)) {
	pd_fail('stdin is not valid JSON (run PHPStan with --error-format=json)');
}
$report += array(
	'files'  => array(),
	'errors' => array(),
	'totals' => array( 'errors' => 0, 'file_errors' => 0 ),
);
if (!is_array($report['files'])) {
	pd_fail('unexpected PHPStan JSON shape: "files" is not an object');
}

// --- Locate the git repository ----------------------------------------------

$topLevelLines = pd_git(array( 'rev-parse', '--show-toplevel' ), $revParseStatus);
if ($revParseStatus !== 0 || !isset($topLevelLines[0]) || $topLevelLines[0] === '') {
	pd_fail('not inside a git repository');
}
$topLevel = $topLevelLines[0];

// --- Compute the changed (new-side) line ranges -----------------------------

$diffArguments = array( 'diff', '--no-color', '--unified=0', '--src-prefix=a/', '--dst-prefix=b/' );
if ($staged) {
	// Compare the index (staged snapshot) rather than the working tree, so
	// unstaged edits are excluded. The base ref stays the merge-base, so
	// committed branch changes are still in scope; pass --base=HEAD to narrow
	// this down to staged changes only.
	$diffArguments[] = '--cached';
}
$mergeBaseLines = pd_git(array( 'merge-base', $base, 'HEAD' ), $mergeBaseStatus);
$mergeBase      = ($mergeBaseStatus === 0 && isset($mergeBaseLines[0])) ? trim($mergeBaseLines[0]) : '';
$diffArguments[] = ($mergeBase !== '') ? $mergeBase : $base;
if ($paths) {
	$diffArguments[] = '--';
	foreach ($paths as $path) {
		$diffArguments[] = $path;
	}
}
$diffOutput = pd_git($diffArguments, $diffStatus);
if ($diffStatus !== 0) {
	pd_fail("`git diff` failed — is " . var_export($base, true) . " a valid ref?");
}

/** @var array<string, list<array{int, int}>> $changed  abs-path => list of inclusive [start,end] new-side ranges */
$changed     = array();
$currentFile = null;   // absolute path of the file currently being parsed (null = skip / between files)
$inHeader    = false;  // true between "diff --git" and the first "@@" of that file section
foreach ($diffOutput as $line) {
	if (str_starts_with($line, 'diff --git ')) {
		$currentFile = null;
		$inHeader    = true;
		continue;
	}
	if ($inHeader) {
		if (str_starts_with($line, '+++ ')) {
			$relativePath = pd_parse_header_path(substr($line, 4));
			if ($relativePath === null) {
				$currentFile = null;
			} else {
				$currentFile = ($relativePath === '' || $relativePath[0] === '/') ? $relativePath : $topLevel . '/' . $relativePath;
				if (!isset($changed[$currentFile])) {
					$changed[$currentFile] = array();
				}
			}
			continue;
		}
		if (str_starts_with($line, '@@ ')) {
			$inHeader = false; // fall through to hunk handling
		} else {
			continue; // index / mode / rename / "--- a/..." header lines
		}
	}
	if (!$inHeader && $currentFile !== null && str_starts_with($line, '@@ ')) {
		if (preg_match('/^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@/', $line, $matches)) {
			$start = (int) $matches[1];
			$count = (isset($matches[2]) && $matches[2] !== '') ? (int) $matches[2] : 1;
			if ($count > 0) {
				$changed[$currentFile][] = array( $start, $start + $count - 1 );
			}
		}
	}
	// Anything else is a hunk body line (+/-) — ignored.
}
foreach (array_keys($changed) as $file) {
	if (!$changed[$file]) {
		unset($changed[$file]); // pure deletions / mode changes / pure renames
	}
}

// --- Filter the report -------------------------------------------------------

$keptFiles = array();
$keptCount = 0;
foreach ($report['files'] as $absolutePath => $data) {
	$ranges = $changed[$absolutePath] ?? null;
	if ($ranges === null) {
		$resolvedPath = @realpath((string) $absolutePath);
		if ($resolvedPath !== false && isset($changed[$resolvedPath])) {
			$ranges = $changed[$resolvedPath];
		}
	}
	if ($ranges === null) {
		continue;
	}
	if ($includes || $excludes) {
		$relativePath = pd_relative_to((string) $absolutePath, $topLevel);
		if ($relativePath === (string) $absolutePath) {
			// Key wasn't under the repo root (e.g. a symlinked path); resolve it,
			// mirroring the realpath fallback used for the changed-line lookup.
			$resolvedPath = @realpath((string) $absolutePath);
			if ($resolvedPath !== false) {
				$relativePath = pd_relative_to($resolvedPath, $topLevel);
			}
		}
		if ($includes) {
			$included = false;
			foreach ($includes as $pattern) {
				if (pd_path_matches($relativePath, $pattern)) {
					$included = true;
					break;
				}
			}
			if (!$included) {
				continue;
			}
		}
		foreach ($excludes as $pattern) {
			if (pd_path_matches($relativePath, $pattern)) {
				continue 2;
			}
		}
	}
	$messages = (is_array($data) && isset($data['messages']) && is_array($data['messages'])) ? $data['messages'] : array();
	$kept     = array();
	foreach ($messages as $message) {
		$lineNumber = (is_array($message) && isset($message['line'])) ? $message['line'] : null;
		if (!is_int($lineNumber) || $lineNumber <= 0) {
			continue;
		}
		foreach ($ranges as $range) {
			if ($lineNumber >= $range[0] && $lineNumber <= $range[1]) {
				$kept[] = $message;
				break;
			}
		}
	}
	if (!$kept) {
		continue;
	}
	$keptFiles[$absolutePath] = array( 'errors' => count($kept), 'messages' => $kept );
	$keptCount += count($kept);
}

$genericErrors = is_array($report['errors']) ? array_values($report['errors']) : array();
$hasErrors     = ($keptCount > 0 || count($genericErrors) > 0);

$report['files']  = $keptFiles;
$report['errors'] = $genericErrors;
$report['totals'] = array( 'errors' => count($genericErrors), 'file_errors' => $keptCount );

// --- Output ------------------------------------------------------------------

if ($format === 'json') {
	$report['files'] = $keptFiles ?: new stdClass();
	echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE), "\n";
	exit($hasErrors ? PD_EXIT_ERRORS : PD_EXIT_OK);
}

// Table format.
$useColor = (getenv('NO_COLOR') === false) && function_exists('stream_isatty') && @stream_isatty(STDOUT);

$columns = (int) (getenv('COLUMNS') ?: 0);
if ($columns <= 0) {
	$ttySize = @shell_exec('{ stty size < /dev/tty ; } 2>/dev/null');
	if (is_string($ttySize) && preg_match('/^\d+\s+(\d+)/', trim($ttySize), $matches)) {
		$columns = (int) $matches[1];
	}
}
if ($columns <= 0) {
	$columns = 120;
}
$columns = max(60, $columns);

$workingDirectory = getcwd();
if ($workingDirectory === false) {
	$workingDirectory = $topLevel;
}

$output = "\n";

if ($keptFiles) {
	$lineColumnWidth = 4; // strlen('Line')
	foreach ($keptFiles as $data) {
		foreach ($data['messages'] as $message) {
			$lineColumnWidth = max($lineColumnWidth, strlen((string) $message['line']));
		}
	}
	$indent             = str_repeat(' ', $lineColumnWidth + 5); // "  " + line col + "   "
	$messageColumnWidth = max(20, $columns - $lineColumnWidth - 6);
	$rule               = ' ' . str_repeat('-', $lineColumnWidth + 2) . ' ' . str_repeat('-', $messageColumnWidth + 2) . "\n";

	foreach ($keptFiles as $absolutePath => $data) {
		$displayPath = pd_relative_to((string) $absolutePath, $workingDirectory);
		$output .= $rule;
		$output .= '  ' . str_pad('Line', $lineColumnWidth) . '   ' . pd_style($displayPath, '1', $useColor) . "\n";
		$output .= $rule;
		foreach ($data['messages'] as $message) {
			$lineNumberText = (string) $message['line'];
			$segments       = explode("\n", wordwrap((string) $message['message'], $messageColumnWidth, "\n", true));
			$first          = true;
			foreach ($segments as $segment) {
				$left = $first
					? pd_style(str_pad($lineNumberText, $lineColumnWidth), '32', $useColor)
					: str_repeat(' ', $lineColumnWidth);
				$output .= '  ' . $left . '   ' . $segment . "\n";
				$first   = false;
			}
			if (!empty($message['tip'])) {
				foreach (explode("\n", wordwrap('💡 ' . $message['tip'], $messageColumnWidth, "\n", true)) as $segment) {
					$output .= $indent . pd_style($segment, '36', $useColor) . "\n";
				}
			}
			if (!empty($message['identifier'])) {
				$output .= $indent . pd_style('🪪  ' . $message['identifier'], '2', $useColor) . "\n";
			}
		}
		$output .= $rule;
		$output .= "\n";
	}
}

if ($genericErrors) {
	foreach ($genericErrors as $error) {
		$text = is_string($error) ? $error : (string) json_encode($error);
		$output .= ' ' . pd_style('✗', '31', $useColor) . ' ' . $text . "\n";
	}
	$output .= "\n";
}

if ($hasErrors) {
	$total = $keptCount + count($genericErrors);
	$label = ' [ERROR] Found ' . $total . ' error' . ($total === 1 ? '' : 's') . ' on changed lines (base: ' . $base . ($staged ? ', staged' : '') . ') ';
	$output .= pd_style($label, '1;37;41', $useColor) . "\n\n";
} else {
	$output .= pd_style(' [OK] No errors on changed lines (base: ' . $base . ($staged ? ', staged' : '') . ') ', '1;37;42', $useColor) . "\n\n";
}

echo $output;
exit($hasErrors ? PD_EXIT_ERRORS : PD_EXIT_OK);
