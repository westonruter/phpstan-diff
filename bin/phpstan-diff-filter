#!/usr/bin/env php
<?php
/**
 * phpstan-diff-filter — read a PHPStan JSON report on stdin, keep only the
 * messages that fall on lines this branch changed relative to a base ref,
 * print them (as a PHPStan-style table or as JSON), and exit 1 if any remain.
 * phpstan-diff does this itself; this is for when PHPStan is run some other way.
 *
 * Usage:
 *   <phpstan> --error-format=json ... | phpstan-diff-filter \
 *       [--base=<ref>] [--staged] [--format=table|json] \
 *       [--include=<glob>]... [--exclude=<glob>]... \
 *       [--phpstan-parameters=<file>] [-- <paths...>]
 *
 * The diff is against `git merge-base <base> HEAD` (or <base> itself if there is
 * none). Unlike phpstan-diff, the filter doesn't look at <base>'s
 * remote-tracking counterparts (see phpstan-diff's --base). With --format=json,
 * the base is reported under "phpstan_diff"."base" in the output document.
 *
 * <paths> restrict the diff to those paths (pass what PHPStan was given).
 *
 * --phpstan-parameters names a file holding `phpstan dump-parameters --json`
 * output; any <paths> its excludePaths cover are listed in a note as not analysed
 * (PHPStan skips them silently). If the file can't be parsed, no note is shown.
 *
 * --include/--exclude keep or drop reported files by repo-relative path or glob,
 * intersected with the changed files. A bare directory (e.g. --include=src)
 * matches everything under it; "*" in a glob may span "/". A file is kept if it
 * matches any --include (when given) and no --exclude (exclude wins).
 *
 * Diff scope:
 *   default   git diff $(git merge-base <base> HEAD)  — every line that differs
 *             from where the branch diverged from <base>, including staged and
 *             unstaged working-tree edits. <base> defaults to $PHPSTAN_DIFF_BASE
 *             or "trunk".
 *   --staged  git diff --cached $(git merge-base <base> HEAD)  — diffs the staged
 *             snapshot (the git index) instead of the working tree: committed +
 *             staged changes, with unstaged edits ignored. Add --base=HEAD to
 *             narrow it to staged changes only (for pre-commit hooks).
 *             Note: PHPStan still analyses the working tree, not the staged blob.
 *
 * Limitation: messages with no line, or a line outside every changed hunk
 * (e.g. some file-level "class not found" errors), are dropped.
 *
 * Exit status: 1 if any errors remain after filtering, 0 if none, 2 on internal errors.
 */

declare(strict_types=1);

namespace WestonRuter\PHPStanDiff;

const PROGRAM = 'phpstan-diff-filter';

require __DIR__ . '/../src/phpstan-diff.php';

// --- Parse arguments ---------------------------------------------------------

$base           = getenv('PHPSTAN_DIFF_BASE');
$base           = (is_string($base) && $base !== '') ? $base : 'trunk';
$staged         = false;
$format         = 'table';
$paths          = array();
$includes       = array();
$excludes       = array();
$parametersFile = null;

/** @var list<string> $argv */
$arguments     = array_slice($argv, 1);
$argumentCount = count($arguments);
for ($index = 0; $index < $argumentCount; $index++) {
	$argument = $arguments[$index];
	if ($argument === '--') {
		array_push($paths, ...array_slice($arguments, $index + 1));
		break;
	}
	if (preg_match('/^--(base|include|exclude|format|phpstan-parameters)(?:=(.*))?$/s', $argument, $matches)) {
		if (!isset($matches[2])) {
			if (!isset($arguments[$index + 1])) {
				fail("--{$matches[1]} requires a value");
			}
			$matches[2] = $arguments[++$index];
		}
		if ($matches[1] === 'base') {
			$base = $matches[2];
		} elseif ($matches[1] === 'include') {
			$includes[] = $matches[2];
		} elseif ($matches[1] === 'exclude') {
			$excludes[] = $matches[2];
		} elseif ($matches[1] === 'format') {
			$format = $matches[2];
		} else {
			$parametersFile = $matches[2];
		}
	} elseif ($argument === '--staged' || $argument === '--cached') {
		$staged = true;
	} elseif ($argument === '-h' || $argument === '--help') {
		print_usage(__FILE__);
		exit(EXIT_OK);
	} elseif (str_starts_with($argument, '--')) {
		fail("unknown option: $argument");
	} else {
		$paths[] = $argument;
	}
}
if ($format !== 'table' && $format !== 'json') {
	fail("--format must be 'table' or 'json'");
}

// --- Read the PHPStan JSON report from stdin --------------------------------

$rawReport = stream_get_contents(STDIN);
if (!is_string($rawReport) || trim($rawReport) === '') {
	fail('no input on stdin (expected PHPStan JSON output)');
}
$report = decode_report($rawReport);
if ($report === null) {
	fail('stdin is not valid JSON (run PHPStan with --error-format=json)');
}

$phpstanParameters = null;
if ($parametersFile !== null) {
	$phpstanParameters = @file_get_contents($parametersFile);
	$phpstanParameters = is_string($phpstanParameters) ? $phpstanParameters : null;
}

exit(filter_report($report, array(
	'base'              => $base,
	'staged'            => $staged,
	'format'            => $format,
	'paths'             => $paths,
	'includes'          => $includes,
	'excludes'          => $excludes,
	'phpstanParameters' => $phpstanParameters,
)));
